#!/bin/bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

cat >/usr/local/bin/status-page-smoke.py <<'PY'
from http.server import BaseHTTPRequestHandler, HTTPServer
import socket


DB_HOST = ${jsonencode(db_probe_host)}
DB_PORT = ${db_probe_port}


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/healthz":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(b'{"status":"ok"}')
            return

        if self.path == "/db-healthz":
            if DB_HOST is None:
                self.send_response(503)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(b'{"status":"not_configured"}')
                return

            try:
                with socket.create_connection((DB_HOST, DB_PORT), timeout=3):
                    pass
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(b'{"status":"ok"}')
                return
            except OSError:
                self.send_response(503)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(b'{"status":"unreachable"}')
                return

        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.end_headers()
        self.wfile.write(b"status-page smoke server\n")

    def log_message(self, format, *args):
        return


HTTPServer(("0.0.0.0", ${app_port}), Handler).serve_forever()
PY

cat >/etc/systemd/system/status-page-smoke.service <<'UNIT'
[Unit]
Description=Status Page temporary smoke server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/status-page-smoke.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now status-page-smoke.service

%{ if create_instance_profile ~}
apt-get update
apt-get install -y docker.io awscli snapd wget

systemctl enable --now docker
systemctl enable --now snapd.socket
snap wait system seed.loaded

if ! snap list amazon-ssm-agent >/dev/null 2>&1; then
  snap install amazon-ssm-agent --classic
fi

systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service

usermod -aG docker ubuntu

aws ecr describe-repositories \
  --repository-names "${ecr_repository_name}" \
  --region "${aws_region}" \
  >/var/log/status-page-ecr-check.log 2>&1 || true

%{ if enable_cloudwatch_agent ~}
cloudwatch_agent_deb="/tmp/amazon-cloudwatch-agent.deb"
wget -q -O "$cloudwatch_agent_deb" "https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb"
dpkg -i -E "$cloudwatch_agent_deb"
rm -f "$cloudwatch_agent_deb"

cat >/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'JSON'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/cloud-init-output.log",
            "log_group_name": "${cloudwatch_log_group_name}",
            "log_stream_name": "{instance_id}/cloud-init-output"
          },
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "${cloudwatch_log_group_name}",
            "log_stream_name": "{instance_id}/syslog"
          }
        ]
      }
    }
  }
}
JSON

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config \
  -m ec2 \
  -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
%{ endif ~}
%{ endif ~}
